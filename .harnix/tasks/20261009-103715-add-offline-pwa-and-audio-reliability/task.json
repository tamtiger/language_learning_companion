  "decisions": [
    {
      "id": "d-handwritten-sw",
      "text": "Service worker viết tay qua plugin Vite (precache + shell fallback), không thêm workbox hay vite-plugin-pwa.",
      "rationale": "Nhu cầu nhỏ, tránh dependency; test được bằng vm với caches/fetch giả."
    },
    {
      "id": "d-export-key",
      "text": "lastExportedAt lưu ở khóa localStorage riêng, không đổi schema tiến độ.",
      "rationale": "Non-goal: không đổi định dạng dữ liệu tiến độ."
    },
    {
      "id": "d-no-auto-reload",
      "text": "Bản service worker mới có hiệu lực ở lần mở sau, không tự reload.",
      "rationale": "Tự reload có thể làm mất bản nháp."
    }
  ],
  "residualRisks": [
    {
      "id": "r-no-png-icons",
      "text": "Chỉ có icon SVG; iOS và một số trình duyệt có thể không cài được hoặc dùng icon chung.",
      "severity": "low"
    },
    {
      "id": "r-no-real-browser",
      "text": "Chưa thử offline và speechSynthesis trên trình duyệt thật; test dùng vm và giả lập; cần kiểm tay Chrome và Safari trước phát hành.",
      "severity": "low"
    },
    {
      "id": "r-persist-denied",
      "text": "persist() có thể bị từ chối khi mở app (Firefox, Safari); nút trong Settings là đường dự phòng, nhắc backup là lớp bảo vệ chính.",
      "severity": "low"
    },
    {
      "id": "r-sw-cache-first",
      "text": "Asset cùng origin cache-first: một file không hash (favicon, icon, manifest) đổi nội dung sẽ chỉ cập nhật khi version precache đổi; hiện version phụ thuộc danh sách tên file, không phải nội dung file tĩnh.",
      "severity": "low"
    }
  ],
  "completedAt": "2026-10-09T15:25:29.094+07:00"
