{
  "name": "language-learning-companion",
  "private": true,
  "version": "1.1.5",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --maxWorkers=4",
    "check:changelog": "node scripts/check-changelog-rule.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:docs": "node scripts/check-docs-layout.mjs",
    "check:bundle": "npm run build && node scripts/check-bundle-size.mjs",
    "check:offline": "npm run build && node scripts/check-offline-build.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.0.5"
  }
}
